{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "products.js"
    }
  },
  "rewrites": [
    {
      "source": "/p/:code",
      "destination": "/api/p?code=:code"
    }
  ],
  "crons": [
    {
      "path": "/api/clean",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}